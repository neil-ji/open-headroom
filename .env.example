# Copy this file to .env and fill in real values before running in production.
# IMPORTANT: Change NEO4J_AUTH before deploying — default credentials are insecure.
NEO4J_AUTH=neo4j/CHANGEME

# Blue-green deployment: which proxy instance Caddy routes traffic to.
# Valid values: blue (default) or green.  The deploy script (make deploy)
# swaps this automatically after each successful deployment.
ACTIVE_COLOR=blue
