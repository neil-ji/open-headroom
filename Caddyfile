# Headroom Blue-Green Reverse Proxy
#
# Caddy is the front door — it listens on :8787 and reverse-proxies to the
# active Headroom instance (headroom-blue:8787 or headroom-green:8787).
#
# Switching: the deploy script runs `sed` on this file to swap the backend
# hostname, `docker cp`s the file into the container, then `caddy reload
# --config /etc/caddy/Caddyfile` for a graceful reload with zero dropped
# connections.
#
# Default active: blue (replace headroom-blue with headroom-green to switch).

:8787 {
    reverse_proxy headroom-blue:8787 {
        # Use Headroom's existing /readyz for health monitoring.
        health_path /readyz
        health_interval 10s
        health_timeout 5s
        health_status 2xx-399
        max_fails 3

        # Graceful shutdown: Caddy waits up to 30 s for in-flight upstream
        # requests to finish before forcibly closing them during a reload.
        # This gives SSE streams and WebSocket sessions time to complete.
        graceful 30s
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
